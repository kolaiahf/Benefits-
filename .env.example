# Copy to .env. Never commit .env.

PORT=8787
HOST=0.0.0.0
NODE_ENV=development
DATABASE_URL=file:./data/agency.db

# At least 32 characters in production. Used to encrypt Finch tokens at rest.
APP_SECRET=change-me-to-a-long-random-string

# Browser origin allowed to call the API during development.
WEB_ORIGIN=http://localhost:5173

# First broker created when the database has no users.
# Production refuses to boot on the default password.
SEED_BROKER_EMAIL=broker@example.com
SEED_BROKER_PASSWORD=demo1234
SEED_BROKER_NAME=Avery Chen

# Finch. Leave blank until you create an app at https://dashboard.tryfinch.com
FINCH_CLIENT_ID=
FINCH_CLIENT_SECRET=
FINCH_REDIRECT_URI=http://localhost:5173/finch/callback
FINCH_API_BASE=https://api.tryfinch.com
# finch uses Finch's sandbox providers. provider uses the payroll vendor's sandbox.
FINCH_SANDBOX=finch

# Optional narrative model. Quotes and recommendations work with no key.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

BCRYPT_ROUNDS=10
