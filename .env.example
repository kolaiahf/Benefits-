# Copy to .env. Never commit .env or put secret values in source.

# Local sqlite. On Vercel/Supabase use the pooler URI instead, for example
# postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=file:./data/agency.db

PORT=8787
HOST=0.0.0.0
NODE_ENV=development

# Required in production. At least 32 characters. Encrypts Finch tokens at rest.
APP_SECRET=change-me-to-a-long-random-string

# Browser origin allowed to call the API. Same-origin Vercel previews can omit it.
WEB_ORIGIN=http://localhost:5173

# First broker created when the database has no users.
# Production refuses to boot when this is missing, shorter than 12 characters, or demo1234.
SEED_BROKER_EMAIL=broker@example.com
SEED_BROKER_PASSWORD=demo1234
SEED_BROKER_NAME=Avery Chen

# Finch sandbox credentials. Leave blank and census CSV upload still quotes.
# Create a sandbox app at https://dashboard.tryfinch.com
FINCH_CLIENT_ID=
FINCH_CLIENT_SECRET=
FINCH_REDIRECT_URI=http://localhost:5173/finch/callback
FINCH_API_BASE=https://api.tryfinch.com
# finch = Finch sandbox providers. provider = a payroll vendor's sandbox.
FINCH_SANDBOX=finch

# Optional narrative model. Quotes work with no key.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

BCRYPT_ROUNDS=10
