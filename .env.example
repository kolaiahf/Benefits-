# Copy to .env. Never commit .env or put secret values in source.
# The quote screen runs without these secrets. Leave the Supabase keys blank
# for local password sign-in (broker@example.com / demo1234).
# Supabase project: pdqxwncosrrlzhqlvofd (us-west-1)
# Dashboard: https://supabase.com/dashboard/project/pdqxwncosrrlzhqlvofd

# Required in production. Copy the Transaction pooler URI (port 6543) from
# Project Settings → Database. Do not paste the password into git.
# postgresql://postgres.pdqxwncosrrlzhqlvofd:[PASSWORD]@aws-0-us-west-1.pooler.supabase.com:6543/postgres
# Local development can keep the sqlite file.
DATABASE_URL=file:./data/agency.db

# Required in production. Project URL and the anon public key.
# The anon key is safe in the browser. Do not set a service-role key anywhere in this app.
NEXT_PUBLIC_SUPABASE_URL=https://pdqxwncosrrlzhqlvofd.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional server-side aliases used when the NEXT_PUBLIC_ names are unset.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Required in production. At least 32 characters. Encrypts Finch tokens at rest.
APP_SECRET=change-me-to-a-long-random-string

PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Browser origin allowed to call a split API process. Same-origin Next does not need it.
WEB_ORIGIN=http://localhost:3000

# Local only. Production uses Supabase Auth and ignores password sign-in.
# AUTH_MODE=password
# AUTH_MODE=supabase

# Optional first admin, created only for local password sign-in or when this password is set.
# Production refuses demo1234 and anything shorter than 12 characters.
SEED_BROKER_EMAIL=broker@example.com
SEED_BROKER_PASSWORD=demo1234
SEED_BROKER_NAME=Avery Chen

# Optional. Blank keeps CSV census quoting working.
FINCH_CLIENT_ID=
FINCH_CLIENT_SECRET=
FINCH_REDIRECT_URI=http://localhost:3000/finch/callback
FINCH_API_BASE=https://api.tryfinch.com
FINCH_SANDBOX=finch

# Optional narrative model. Quotes work with no key.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

BCRYPT_ROUNDS=10

# Optional brand. Defaults live in src/brand.ts.
BRAND_PRODUCT_NAME=
BRAND_AGENCY_NAME=
BRAND_MARK=
BRAND_LOGO_URL=
BRAND_COLOR_INK=
BRAND_COLOR_MUTED=
BRAND_COLOR_PAPER=
BRAND_COLOR_PANEL=
BRAND_COLOR_LINE=
BRAND_COLOR_ACCENT=
BRAND_COLOR_ACCENT_INK=
BRAND_COLOR_KICKER=
BRAND_COLOR_KICKER_WASH=
BRAND_COLOR_DANGER=
BRAND_COLOR_RAIL=
BRAND_COLOR_RAIL_INK=
BRAND_COLOR_RAIL_MUTED=
BRAND_COLOR_MARK=
