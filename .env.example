# ─────────────────────────────────────────────────────────────
# Copy to .env and fill in. NEVER commit .env (it's gitignored).
# ─────────────────────────────────────────────────────────────

# Database (libSQL / SQLite dialect).
#   Local dev:   file:./prisma-dev.db   (a local file, zero setup)
#   Production:  libsql://<your-db>.turso.io   (managed, replicated libSQL)
DATABASE_URL="file:./prisma-dev.db"
# Only needed for a remote libSQL/Turso database:
DATABASE_AUTH_TOKEN=""

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"

# Anthropic / Claude API key (server-side only, never exposed to the browser)
ANTHROPIC_API_KEY=""

# Model id for the Ask-AI assistant
ANTHROPIC_MODEL="claude-opus-4-8"
